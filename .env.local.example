# Copy this file to .env.local for local development.
# In Vercel, add these same names under Project Settings -> Environment Variables instead.

# Demo login credentials (same concept as DEMO_USERNAME/DEMO_USER_PASSWORD
# in the existing Python project's .env).
DEMO_USERNAME=
DEMO_USER_PASSWORD=

# DEMO_MEMBER_ID is only used by the disabled BSE clone (disabled-pages/bse-login.js).
# Not needed for the active NSE login page.
DEMO_MEMBER_ID=

# Fake, fixed-answer captcha for the active NSE login page -- this is a stand-in
# for structure/flow testing only, not a real captcha challenge.
# DEMO_CAPTCHA_TEXT is checked server-side; NEXT_PUBLIC_DEMO_CAPTCHA_TEXT is the
# same value shown in the browser (must be NEXT_PUBLIC_-prefixed to be visible
# client-side -- keep both in sync).
DEMO_CAPTCHA_TEXT=TEST12
NEXT_PUBLIC_DEMO_CAPTCHA_TEXT=TEST12

# Gmail SMTP sender used to trigger the MFA email (same values as
# GMAIL_SENDER_ADDRESS/GMAIL_APP_PASSWORD in the existing Python project's .env)
GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=

# The Outlook account with the forwarding Rule on it (same value as
# MFA_TEST_TARGET_EMAIL in the existing Python project's .env)
MFA_TARGET_EMAIL=

# Any random long string, used to sign session cookies so they can't be forged
SESSION_SECRET=
